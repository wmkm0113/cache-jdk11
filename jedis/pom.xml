<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>cache-jdk11</artifactId>
		<groupId>org.nervousync</groupId>
		<version>1.1.8</version>
	</parent>
	<modelVersion>4.0.0</modelVersion>
	<artifactId>cache-jedis-jdk11</artifactId>
	<version>${current.version}</version>
	<packaging>jar</packaging>
	<name>Jedis Provider</name>
	<url>https://nervousync.org/projects/cache/jdk11/providers/jedis/index.shtml</url>
	<description>Cache Provider Implements By Jedis, development by Nervousync Studio (NSYC)</description>
	<properties>
		<jedis.version>6.0.0</jedis.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.nervousync</groupId>
			<artifactId>cache-api-jdk11</artifactId>
			<version>1.1.8-SNAPSHOT</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.nervousync</groupId>
			<artifactId>cache-core-jdk11</artifactId>
			<version>${current.version}</version>
		</dependency>
		<dependency>
			<groupId>org.nervousync</groupId>
			<artifactId>cache-test-jdk11</artifactId>
			<version>1.0.1</version>
			<scope>test</scope>
		</dependency>
		<!-- Jedis Support -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-pool2</artifactId>
			<version>2.12.1</version>
		</dependency>
		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>20250517</version>
		</dependency>
		<dependency>
			<groupId>redis.clients</groupId>
			<artifactId>jedis</artifactId>
			<version>${jedis.version}</version>
			<exclusions>
				<exclusion>
					<groupId>org.apache.commons</groupId>
					<artifactId>commons-pool2</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.json</groupId>
					<artifactId>json</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>
</project>